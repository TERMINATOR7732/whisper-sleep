# Whisper Sleep / Nightly — Environment Variables Template

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Web Push Notifications (VAPID)
# Client-side (Public key used as applicationServerKey for pushManager.subscribe)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Server-side / Edge Functions only (NEVER expose to client or prefix with VITE_)
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:support@nightly.app

# Scheduler Auth Secret (used by pg_cron / pg_net)
CRON_SECRET=your-scheduler-cron-secret-here
